#!/usr/sbin/nft -f

flush ruleset

table inet honeyshield {
    set blocked_sources {
        type ipv4_addr
    }

    chain forward {
        type filter hook forward priority filter; policy drop;

        iifname "enp0s3" ip saddr @blocked_sources drop

        ct state established,related accept

        iifname "enp0s3" oifname "enp0s8" \
        ip saddr 10.10.10.0/24 ip daddr 10.10.20.20 \
        tcp dport 80 ct state new accept

        iifname "enp0s3" oifname "enp0s8" \
        ip saddr 10.10.10.0/24 ip daddr 10.10.20.30 \
        tcp dport 2222 ct state new accept
    }
}

table ip honey_nat {
    set redirected_sources {
        type ipv4_addr
    }

    chain prerouting {
        type nat hook prerouting priority dstnat; policy accept;

        iifname "enp0s3" \
        ip saddr @redirected_sources \
        ip daddr 10.10.10.1 \
        tcp dport 2222 \
        dnat to 10.10.20.30:2222
    }
}
